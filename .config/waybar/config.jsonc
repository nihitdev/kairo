{
  "layer": "top",
  "position": "top",
  "height": 32,
  "spacing": 3,
  "margin-top": 7,
  "margin-left": 40,
  "margin-right": 40,
  "modules-left": [
    "hyprland/workspaces",
    "custom/layout",
    "custom/cpucat"
  ],
  "modules-center": [
    "mpris"
  ],
  "modules-right": [
    "group/connectivity",
    "group/system",
    "clock",
    "custom/notifications",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "sort-by-number": true,
    "disable-scroll": true,
    "all-outputs": false,
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "●"
    }
  },
  "custom/layout": {
    "exec": "~/.config/waybar/scripts/layout-status.sh",
    "interval": "once",
    "signal": 8,
    "format": "{}",
    "on-click": "~/.config/hypr/scripts/toggle-layout.sh",
    "tooltip-format": "Layout: {}\nClick / Super+L: Dwindle → Scrolling → Master",
    "tooltip": true,
    "exec-on-event": false
  },
  "custom/skull": {
    "exec": "~/.config/waybar/scripts/skull.sh",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "ARCHNEMESIS\nClick: shortcuts · Super+/",
    "restart-interval": 5,
    "on-click": "~/.config/hypr/scripts/keybinds.sh"
  },
  "custom/cpucat": {
    "exec": "~/.config/waybar/scripts/catloop.sh",
    "tooltip": false,
    "restart-interval": 5
  },
  "mpris": {
    "format": "  {title}",
    "format-paused": "󰏤  {title}",
    "max-length": 24,
    "tooltip": true,
    "on-click": "playerctl play-pause",
    "on-click-right": "~/.config/waybar/scripts/tui.sh music",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": "󰕾  {volume}%",
    "format-muted": "󰝟  muted",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/tui.sh audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "max-volume": 100,
    "tooltip-format": "{node_name}\nClick: mixer · Right-click: mute · Scroll: volume"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "󰃠  {percent}%",
    "tooltip": true,
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl --min-value=1 set 5%-",
    "tooltip-format": "Brightness: {percent}%\nScroll to adjust"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󱐋  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/tui.sh system",
    "interval": 30,
    "tooltip-format": "{capacity}% · {timeTo}\n{power:.1f} W\nClick: system monitor"
  },
  "clock": {
    "format": "{:%a  %H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "~/.config/waybar/scripts/tui.sh calendar"
  },
  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "format": "{icon}",
    "on-click": "qs ipc --path \"$HOME/.config/quickshell/hyprland-notifications\" call notifications toggle",
    "on-click-right": "qs ipc --path \"$HOME/.config/quickshell/hyprland-notifications\" call notifications toggleDnd",
    "tooltip-format": "Notifications: {text}\nClick: panel · Right-click: Do Not Disturb",
    "tooltip": true,
    "return-type": "json",
    "restart-interval": 5,
    "exec-on-event": false,
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    },
    "on-click-middle": "qs ipc --path \"$HOME/.config/quickshell/hyprland-notifications\" call notifications clear"
  },
  "custom/power": {
    "format": "",
    "on-click": "\"$HOME/.config/rofi/powermenu/type-2/powermenu.sh\"",
    "tooltip-format": "Session and power menu",
    "tooltip": true
  },
  "reload_style_on_change": true,
  "fixed-center": true,
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "network",
      "bluetooth"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "wireplumber",
      "backlight",
      "battery"
    ]
  },
  "network": {
    "format-wifi": "",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰖪",
    "tooltip-format-wifi": "{essid} · {signalStrength}%\n{ipaddr}\nClick: network settings",
    "tooltip-format-ethernet": "{ifname} · {ipaddr}",
    "tooltip-format-disconnected": "Disconnected · click to connect",
    "on-click": "~/.config/waybar/scripts/tui.sh network",
    "interval": 10
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂱",
    "tooltip-format": "Bluetooth: {status}\nClick: Bluetooth settings",
    "tooltip-format-connected": "{device_alias}\n{device_enumerate}",
    "on-click": "~/.config/waybar/scripts/tui.sh bluetooth"
  }
}
