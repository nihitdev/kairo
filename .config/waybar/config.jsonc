{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 2,
  "margin-top": 5,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "hyprland/workspaces",
    "custom/layout",
    "custom/cpucat"
  ],
  "modules-center": [
    "custom/skull"
  ],
  "modules-right": [
    "mpris",
    "group/connectivity",
    "group/system",
    "clock",
    "custom/notifications",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },
  "custom/layout": {
    "exec": "~/.config/waybar/scripts/layout-status.sh",
    "interval": "once",
    "signal": 8,
    "format": "{}",
    "on-click": "~/.config/hypr/scripts/toggle-layout.sh",
    "tooltip-format": "Layout: {}\nClick / Super+L: switch Dwindle ↔ Scrolling",
    "tooltip": true,
    "exec-on-event": false
  },
  "custom/skull": {
    "exec": "~/.config/waybar/scripts/skull.sh",
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "ARCHNEMESIS",
    "restart-interval": 5
  },
  "custom/cpucat": {
    "exec": "~/.config/waybar/scripts/catloop.sh",
    "tooltip": false,
    "restart-interval": 5
  },
  "mpris": {
    "format": "  {artist} - {title}",
    "format-paused": "󰐊  {artist} - {title}",
    "max-length": 24,
    "player": "spotify",
    "tooltip": true,
    "on-click": "playerctl --player=spotify play-pause",
    "on-click-right": "~/.config/waybar/scripts/tui.sh music",
    "on-scroll-up": "playerctl --player=spotify next",
    "on-scroll-down": "playerctl --player=spotify previous"
  },
  "custom/network": {
    "format": "",
    "on-click": "~/.config/waybar/scripts/tui.sh network",
    "tooltip-format": "Network",
    "tooltip": true
  },
  "custom/bluetooth": {
    "format": "",
    "on-click": "~/.config/waybar/scripts/tui.sh bluetooth",
    "tooltip-format": "Bluetooth",
    "tooltip": true
  },
  "wireplumber": {
    "scroll-step": 5,
    "format": "󰕾  {volume}%",
    "format-muted": "󰝟  muted",
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/tui.sh audio",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "max-volume": 100,
    "tooltip-format": "{node_name}\nClick: mixer · Right-click: mute · Scroll: volume"
  },
  "backlight": {
    "device": "intel_backlight",
    "format": "󰃠  {percent}%",
    "tooltip": true,
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-",
    "tooltip-format": "Brightness: {percent}%\nScroll to adjust"
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-plugged": "󱐋  {capacity}%",
    "format-full": "󰁹  {capacity}%",
    "format-icons": [
      "󰂎",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "tooltip": true,
    "on-click": "~/.config/waybar/scripts/tui.sh system"
  },
  "clock": {
    "format": "  {:%H:%M}",
    "tooltip-format": "{:%A, %d %B %Y}",
    "on-click": "~/.config/waybar/scripts/tui.sh calendar"
  },
  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "format": "{icon}",
    "on-click": "swaync-client -t",
    "on-click-right": "swaync-client -d",
    "tooltip-format": "Notifications: {text}\nClick: panel · Right-click: Do Not Disturb",
    "tooltip": true,
    "return-type": "json",
    "restart-interval": 5,
    "exec-on-event": false,
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂛",
      "dnd-none": "󰪑",
      "inhibited-notification": "󰂚",
      "inhibited-none": "󰂜",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑"
    }
  },
  "custom/power": {
    "format": "",
    "on-click": "\"$HOME/.config/rofi/powermenu/type-2/powermenu.sh\"",
    "tooltip-format": "Session and power menu",
    "tooltip": true
  },
  "reload_style_on_change": true,
  "fixed-center": true,
  "group/connectivity": {
    "orientation": "horizontal",
    "modules": [
      "custom/network",
      "custom/bluetooth"
    ]
  },
  "group/system": {
    "orientation": "horizontal",
    "modules": [
      "wireplumber",
      "backlight",
      "battery"
    ]
  }
}
