[general]
framerate = 60
bars = 0
bar_width = 2
bar_spacing = 1
autosens = 1
sensitivity = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average
reverse = 0

[color]
background = 'default'
foreground = '#cba6f7'
gradient = 1
gradient_count = 6
gradient_color_1 = '#89b4fa'
gradient_color_2 = '#b4befe'
gradient_color_3 = '#cba6f7'
gradient_color_4 = '#f5c2e7'
gradient_color_5 = '#f2cdcd'
gradient_color_6 = '#f5e0dc'

[smoothing]
integral = 77
gravity = 100
noise_reduction = 77
