/* Generated by Matugen from the active wallpaper. */
* {
    background: {{colors.surface.default.hex_alpha | set_alpha: 0.78}};
    background-alt: {{colors.surface_container.default.hex_alpha | set_alpha: 0.90}};
    foreground: {{colors.on_surface.default.hex}};
    selected: {{colors.primary.default.hex}};
    active: {{colors.secondary.default.hex}};
    urgent: {{colors.error.default.hex}};
    muted: {{colors.outline.default.hex}};

    bg: {{colors.surface.default.hex_alpha | set_alpha: 0.90}};
    card: {{colors.surface_container.default.hex_alpha | set_alpha: 0.80}};
    card-hover: {{colors.surface_container_high.default.hex_alpha | set_alpha: 0.87}};
    text: {{colors.on_surface.default.hex}};
    purple: {{colors.primary.default.hex}};
    cyan: {{colors.secondary.default.hex}};
}
