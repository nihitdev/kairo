/* Generated by Matugen from the active wallpaper. */
* {
    background: #151218C7;
    background-alt: #221E24E6;
    foreground: #e8e0e8;
    selected: #d8bafa;
    active: #cfc1da;
    urgent: #ffb4ab;
    muted: #958e98;

    bg: #151218E6;
    card: #221E24CC;
    card-hover: #2C292FDE;
    text: #e8e0e8;
    purple: #d8bafa;
    cyan: #cfc1da;
}
