# ─────────────────────────────────────────────────────────────────────────────
# Ignored Files
# ─────────────────────────────────────────────────────────────────────────────

# Local caches and temporary files
*.bak
*.swp
*.tmp
.DS_Store
Thumbs.db

# Editor state
.idea/
.vscode/
site/node_modules/
site/dist/

# Per-machine desktop state (never publish wallpaper links or generated locks)
.config/hypr/current-wallpaper
.config/hypr/config/bar.lua
.config/hyprlock/hyprlock.conf

# Python runtime caches
__pycache__/
*.py[cod]
